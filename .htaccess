# Email Bounce Monitor (EBM) — minimal install .htaccess
#
# This is the *shipping* version, kept as small as possible so the
# installer always loads, even on restrictive Apache setups.
# The full production rules (security headers, caching, compression,
# framework-folder protection, etc.) are written automatically by the
# installer at the end of a successful setup.
#
# IMPORTANT — keep this file in LF (Unix) line endings; see .gitattributes.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files / dirs as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>
